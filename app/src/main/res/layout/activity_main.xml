<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OTP Bridge" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture verification codes from SMS and Gmail, then make the latest code available through Android Autofill." android:layout_marginTop="8dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mobile number" android:layout_marginTop="24dp" />
    <EditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="+91XXXXXXXXXX" android:inputType="phone" />
    <Button android:id="@+id/smsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Listen for SMS OTP" android:layout_marginTop="16dp" />
    <Button android:id="@+id/gmailButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect / Sync Gmail" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No OTP captured" android:textSize="18sp" android:layout_marginTop="24dp" />
    <TextView android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="42sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp" />
    <Button android:id="@+id/copyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copy latest code" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tip: enable OTP Bridge under Settings → System → Autofill service. Android/Gboard decides whether the autofill suggestion appears above the keyboard." android:layout_marginTop="24dp" />
</LinearLayout>
</ScrollView>
